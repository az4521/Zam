<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backup is OFF: the app's data dir holds the Matrix access token and the
         plaintext rust-crypto store, so a cloud backup or a device-to-device
         transfer would copy long-lived credentials and E2EE keys out of the
         installation they belong to. allowBackup covers API <= 30;
         dataExtractionRules covers API 31+, where it supersedes allowBackup and
         where device transfer needs its own opt-out. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Displays notifications for Sygnal's data-only FCM messages.
             Higher priority than the Capacitor plugin's MessagingService so
             Android routes MESSAGING_EVENT here. -->
        <service
            android:name=".MatrixMessagingService"
            android:exported="false">
            <intent-filter android:priority="1">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Decline action on an incoming-call notification: cancels it without
             opening the app. Not exported — only our own PendingIntent fires it. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- Reply and Mark-read actions on a message notification: extract the
             RemoteInput text (if any), launch MainActivity with the action data,
             and cancel the notification. Not exported — only our own PendingIntent
             fires it. -->
        <receiver
            android:name=".MessageActionReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Full-screen incoming-call notifications that wake the screen / show over
         the lockscreen. On API 34+ the OS grants this by default only to
         calling/alarm apps; otherwise the intent degrades to a heads-up (still
         rings + shows Accept/Decline). See showCallNotification() in
         MatrixMessagingService for the API-level behaviour. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Declaring CAMERA implicitly marks camera (and autofocus) as REQUIRED
         hardware for Google Play filtering. Video calling is optional here, so
         opt back out and stay installable on camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
