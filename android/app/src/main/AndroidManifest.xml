<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Backup is OFF: the app's data dir holds the Matrix access token and the
         plaintext rust-crypto store, so a cloud backup or a device-to-device
         transfer would copy long-lived credentials and E2EE keys out of the
         installation they belong to. allowBackup covers API <= 30;
         dataExtractionRules covers API 31+, where it supersedes allowBackup and
         where device transfer needs its own opt-out. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- SSO sign-in: the homeserver redirects the system browser back
                 here with a one-time loginToken (see src/lib/matrix/sso.ts). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moe.crafty.matrix" android:host="sso" />
            </intent-filter>

            <!-- OAuth sign-in: the provider redirects the system browser to
                 moe.crafty.matrix:/oauth (RFC 8252 private-use scheme, the
                 reverse-DNS of the registered client_uri). A host-less URI is
                 only matched by a scheme-only filter (see src/lib/matrix/oauth.ts). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moe.crafty.matrix" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Displays notifications for Sygnal's data-only FCM messages.
             Higher priority than the Capacitor plugin's MessagingService so
             Android routes MESSAGING_EVENT here. -->
        <service
            android:name=".MatrixMessagingService"
            android:exported="false">
            <intent-filter android:priority="1">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Decline action on an incoming-call notification: cancels it without
             opening the app. Not exported — only our own PendingIntent fires it. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- Reply and Mark-read actions on a message notification: extract the
             RemoteInput text (if any), launch MainActivity with the action data,
             and cancel the notification. Not exported — only our own PendingIntent
             fires it. -->
        <receiver
            android:name=".MessageActionReceiver"
            android:exported="false" />

        <!-- Held for the whole of an active call so it keeps working in the
             background and with the screen off (see CallService). phoneCall
             is the VoIP-app type; microphone / camera keep capture alive
             while the app is not visible. -->
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />

        <!-- Self-managed ConnectionService: registers our calls with the
             system call stack (Telecom) so they behave like phone calls —
             Bluetooth / car answer and hang-up, cellular calls hold them,
             system audio routing (see TelecomCalls). Exported only to
             Telecom, which alone holds BIND_TELECOM_CONNECTION_SERVICE. -->
        <service
            android:name=".MatrixConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            tools:targetApi="26">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Full-screen incoming-call notifications that wake the screen / show over
         the lockscreen. On API 34+ the OS grants this by default only to
         calling/alarm apps; otherwise the intent degrades to a heads-up (still
         rings + shows Accept/Decline). See showCallNotification() in
         MatrixMessagingService for the API-level behaviour. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Calls as real phone-style calls (CallService): MANAGE_OWN_CALLS is the
         self-managed VoIP calling permission (normal, granted at install) that
         API 34+ requires for a phoneCall foreground service; the typed
         FOREGROUND_SERVICE_* permissions keep the mic / camera live in the
         background; WAKE_LOCK keeps the CPU and Wi-Fi up with the screen off. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Declaring CAMERA implicitly marks camera (and autofocus) as REQUIRED
         hardware for Google Play filtering. Video calling is optional here, so
         opt back out and stay installable on camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
