# Live-testing credentials for automated (overnight) verification.
# Real values go in .env (gitignored) — never commit them.
# No VITE_ prefix: these must never reach the client bundle.
MATRIX_TEST_SERVER=https://matrix.example.org
MATRIX_TEST_USER=@user:example.org
MATRIX_TEST_PASSWORD=

# Second account for multi-account testing (may be on a different server).
MATRIX_TEST2_SERVER=https://matrix.example.org
MATRIX_TEST2_USER=@user2:example.org
MATRIX_TEST2_PASSWORD=

# GIF picker (KLIPY) — client-side, so VITE_-prefixed. OPTIONAL: unset defaults
# to KLIPY's public `web` key, so GIF search works with zero setup. Set your own
# registered key (partner.klipy.com) only to unlock memes/clips or get a private
# rate limit.
VITE_KLIPY_API_KEY=
