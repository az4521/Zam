{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
        "strict": true,
        "noEmit": true,
        "allowJs": true,
        "checkJs": false,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "types": ["vite/client", "@webgpu/types"],
        "baseUrl": ".",
        "paths": {
            "$lib/*": ["../../src/lib/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.test.ts"]
}
